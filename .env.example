# Copy to .env.local for local development. Never commit real values.

# --- Database (identity + billing only; never answers) ---
# Heroku sets this for you when the Postgres add-on is attached.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Sessions ---
# Signs the session cookie. Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Google sign-in (optional; button stays off until both are set) ---
# Redirect URI: https://www.lovevalues.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Meta sign-in — Facebook AND Instagram, one integration (optional) ---
# Redirect URI: https://www.lovevalues.com/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# --- Synthesis engine ---
ANTHROPIC_API_KEY=
