# The synthesis engine. Server-side only — never expose this to the browser.
# Without it, /api/synthesize returns a clear 503 and the rest of the app works.
ANTHROPIC_API_KEY=sk-ant-...

# Canonical origin, used for metadata and OpenRouter attribution.
# Set to whichever host you actually serve — if the apex forwards to www, use www.
NEXT_PUBLIC_SITE_URL=https://www.lovevalues.com

# ── Optional: the resilience lane ────────────────────────────────────────────
# When set, a FAILED Anthropic call retries the same prompt on an open model
# via OpenRouter, so the profile degrades instead of going dark. Claude stays
# primary and healthy calls are never re-routed. Leave unset and the lane is
# inert — no third party sees anything.
#
# Turning this on means a user's answers can reach OpenRouter and its upstream
# provider. That is disclosed on /privacy; if you enable it, keep that text
# accurate. We send provider.data_collection="deny" so providers that train on
# prompts are excluded.
# OPENROUTER_API_KEY=sk-or-...

# Which open model the lane uses. Default: deepseek/deepseek-r1 (MIT) — the
# reasoning-heavy job is synthesis, and R1 is the strongest permissive option.
# VERIFY the exact slug at openrouter.ai/models; provider slugs drift, and a
# wrong one fails at request time rather than at deploy time.
# LOVEVALUES_FALLBACK_MODEL=deepseek/deepseek-r1
